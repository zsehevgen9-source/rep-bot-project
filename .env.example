# --- MAX ---
MAX_BOT_TOKEN=your-bot-token
MAX_API_URL=https://platform-api.max.ru
# Если токен работает только с другим хостом (например, https://platform-api2.max.ru), укажите его здесь.
# При ошибке CERTIFICATE_VERIFY_FAILED: положите сертификаты Минцифры в docker/certs (см. README там).
# Временный обход (небезопасно, токен уходит без проверки сервера): MAX_SSL_VERIFY=false
MAX_SSL_VERIFY=true

# --- ИИ (Yandex Cloud: YandexGPT, SpeechKit) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# aliceai-llm — Alice AI (самая умная), yandexgpt-5.1 — Pro 5.1, yandexgpt-5-pro — Pro 5
YANDEX_GPT_MODEL=aliceai-llm
# Дешёвая модель для простых действий: проверить ответ, разобрать расписание или фото домашки
YANDEX_GPT_LIGHT_MODEL=yandexgpt-lite
# Голос бота. Послушать варианты — команда /voices в чате с ботом (только для администратора)
TTS_VOICE=alexander
TTS_ROLE=good
# Кому озвучивать сообщения: all — всем сразу, young — только 1–4 классам, button — всем по кнопке «🔊 Послушать»
# (голосовое делается и оплачивается, только когда ученик нажал), off — никому.
# Ученик может сам включить или выключить голос: «⚙️ Настройки → 🔊 Голос»
VOICE_MODE=button
# Одинаковые фразы озвучиваются один раз, дальше берутся из кеша бесплатно
TTS_CACHE=true

# --- Задания ---
# false — бот не будет придумывать задания сам, только брать из банка (data/tasks.json) и sdamgia (ЕГЭ)
ALLOW_AI_TASKS=true
# Сколько новых тестов/уроков/разборов фото от ИИ можно одному ученику в день (0 — без лимита)
AI_DAILY_LIMIT=40
# Оформление: жирные заголовки (true/false) и картинки-карточки (true/false)
PRETTY_MESSAGES=true
IMAGE_CARDS=true
# Мини-приложение: сервер на порту 8080; кнопку в меню бота включить (true) после подключения адреса в MAX
WEBAPP_ENABLED=true
WEBAPP_PORT=8080
MINIAPP_BUTTON=false
# На сервере: адрес мини-приложения для HTTPS и включение Caddy (заполняет scripts/server_https.sh)
# MINIAPP_DOMAIN=51-250-12-34.sslip.io
# COMPOSE_PROFILES=https

# Согласие на обработку данных перед знакомством (true — спрашивать) и контакт для политики /privacy
CONSENT_REQUIRED=true
PRIVACY_CONTACT=

# --- Администраторы: ID в MAX через запятую (узнать свой — командой /whoami). Доступны /stats и /demo ---
ADMIN_IDS=
# --- Учителя: ID в MAX через запятую — кабинет учителя /teacher (или администратор пишет /add_teacher ID) ---
TEACHER_IDS=
# Подтверждать новых учителей вручную (true) или открывать кабинет сразу по кнопке «Я учитель» (false)
TEACHER_APPROVAL=false

# «🎨 Объясни по-другому» (через футбол, космос, аниме…): новых объяснений в день на ученика
VIA_DAILY_LIMIT=5

# --- PostgreSQL (docker compose берёт эти значения для контейнера БД) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bot_db

# --- Для ЛОКАЛЬНОГО запуска без Docker (python -m app.main). В контейнере bot эти URL подменяются автоматически ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_db
REDIS_URL=redis://localhost:6379/0
